# OpenRouter API (obtén la clave en https://openrouter.ai)
# Usa un modelo gratis como deepseek/deepseek-v3 o cualquier otro disponible en OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxx-xxxxx
OPENROUTER_MODEL=sk-or-xxxxx-xxxxx

# Instagram API (opcional, para publicar)
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN

# Configuración del servidor
PORT=3000
NODE_ENV=development
