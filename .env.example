# Copia este archivo a .env y completa los valores
PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

UPLOAD_DIR=./uploads
OUTPUT_DIR=./renders

REMOTION_ENTRY=../remotion/src/index.ts
REMOTION_PUBLIC_DIR=../remotion/public

# Upload-Post (Instagram / Facebook - FALLBACK si no usas Graph API directa)
UPLOADPOST_API_URL=https://api.upload-post.com/api/upload
UPLOADPOST_API_KEY=
UPLOADPOST_USER=poker-club-marketing

# Instagram Graph API (PUBLICACION DIRECTA - RECOMENDADA)
IG_ACCESS_TOKEN=IGAA...tu_token_de_acceso... (lo tienes en .env)
IG_USER_ID=ID_numerico_de_tu_cuenta_Instagram_Business_Creator (OBLIGATORIO)
IG_API_VERSION=v18.0

# Facebook (opcional)
FACEBOOK_API_URL=https://graph.facebook.com/v18.0/me/photos
FACEBOOK_API_KEY=
FACEBOOK_USER=

# Twitter / X (opcional)
TWITTER_API_URL=https://api.twitter.com/2/tweets
TWITTER_API_KEY=
TWITTER_USER=

# TikTok (opcional)
TIKTOK_API_URL=https://open-api.tiktok.com/share/video/upload/
TIKTOK_API_KEY=
TIKTOK_USER=

# OpenRouter (para generacion de video con IA)
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=deepseek/deepseek-v3

# Redis (opcional, si no esta disponible se usa scheduler por archivo)
REDIS_HOST=localhost
REDIS_PORT=6379
